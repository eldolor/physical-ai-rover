+    def _sidestep_turn(self) -> Optional[str]:
+        """3.148: LEFT or RIGHT, away from the nearest scan return within
+        SIDESTEP_LOOK_DEG of ahead and SIDESTEP_NEAR_M; None when there is no
+        usable scan, nothing that near, or it is square ahead. Scan angles are
+        the body's, clockwise-positive (`RobotInterface.get_scan`)."""
+        try:
+            scan = self.robot.get_scan(max_range_m=SIDESTEP_NEAR_M + 0.2)
+        except Exception:  # noqa: BLE001 -- no scan: the back-off as it was
+            return None
+        if not scan or not scan.get("usable"):
+            return None
+        a0, da = scan.get("angle_min_deg"), scan.get("angle_increment_deg")
+        if a0 is None or not da:
+            return None
+        best = None
+        for i, r in enumerate(scan.get("ranges_m") or []):
+            if r is None or r > SIDESTEP_NEAR_M:
+                continue
+            a = (a0 + i * da + 180.0) % 360.0 - 180.0
+            if abs(a) <= SIDESTEP_LOOK_DEG and (best is None or r < best[0]):
+                best = (r, a)
+        if best is None or abs(best[1]) < SIDESTEP_CENTRE_DEG:
+            return None
+        return "LEFT" if best[1] > 0 else "RIGHT"
+
