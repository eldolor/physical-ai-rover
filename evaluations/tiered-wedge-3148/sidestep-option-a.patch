+# 3.148: the back-off's sidestep. With no tier able to steer (no cloud, no
+# local VLM, no nav2) the tiered policy aims straight at the target, and a
+# line that clips a door jamb was retraced after every back-off until the
+# mission ended `blocked` (3.135.B F11a/F11b/F12a: 6 of 15 board runs). So
+# after its REVERSE the back-off turns SIDESTEP_DEG away from the nearest
+# scan return within SIDESTEP_LOOK_DEG of ahead and SIDESTEP_NEAR_M, and
+# creeps one vetted FORWARD, before the policy re-aims from the new line. A
+# return within SIDESTEP_CENTRE_DEG of dead ahead (a wall square on) or none
+# that near leaves the back-off as it was.
+SIDESTEP_DEG = 30
+SIDESTEP_LOOK_DEG = 45.0
+SIDESTEP_NEAR_M = 1.0          # past the back-off's own REVERSE (the jamb read 0.60 m after it)
+SIDESTEP_CENTRE_DEG = 5.0
