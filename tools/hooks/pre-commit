#!/bin/sh
# The plan's commit guard (docs/guides/PARALLEL-SESSIONS.md, rules 8 and 12):
# REFUSES a commit on a plan/3.N-* branch unless this Claude Code session
# holds a claim in section 3.N (a merge passes), and warns when a staged
# file lies inside another live session's claim -- which catches edits made
# through Bash, which the edit hook cannot see. A person (never an agent)
# overrides with PICAR_CLAIM_BYPASS=1. Installed by `git config
# core.hooksPath tools/hooks` (or this checkout's absolute tools/hooks): it
# runs the plan_claims.py of the worktree committing, and does nothing in a
# worktree whose branch predates it.
root="$(git rev-parse --show-toplevel)"
if [ -f "$root/tools/plan_claims.py" ]; then
  python3 "$root/tools/plan_claims.py" hook-commit </dev/null || exit 1
fi
exit 0
