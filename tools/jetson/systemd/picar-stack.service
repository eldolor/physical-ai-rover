[Unit]
Description=vision-picar robot server, brain and proxy (service/tunnel/run.sh)
After=network-online.target
Wants=network-online.target

[Service]
User=picar
WorkingDirectory=/home/picar/vision-picar-service
# 3.108 (the user, 2026-10-26): the local VLM on by default on the board.
# The stack does not wait for it: a VLM that is loading, down or killed
# leaves the stack up, and the brain sends those questions to the cloud tier.
Environment=LOCAL_VLM_URL=http://127.0.0.1:8005
ExecStart=/bin/bash service/tunnel/run.sh
Restart=on-failure
RestartSec=5
KillMode=mixed
# 3.80.B: below everything else when memory runs out, the local VLM
# (+1000) first. Not -1000: a stack that is itself the leak stays killable.
OOMScoreAdjust=-900
# 3.155: the robot server locks its touched pages (robot/locked_serve.py), so
# a squeeze cannot stall its wheel loop on page faults; it locks only under
# an unlimited memlock limit (systemd's default is 64 KB).
LimitMEMLOCK=infinity
TimeoutStopSec=20
StandardOutput=append:/home/picar/.vision-picar-tunnel.log
StandardError=append:/home/picar/.vision-picar-tunnel.log

[Install]
WantedBy=multi-user.target
